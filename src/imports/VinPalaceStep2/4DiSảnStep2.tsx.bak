function Frame23({ isNextActive }: { isNextActive: boolean }) {
  const navigate = useNavigate();

  return (
    <div className="content-stretch flex gap-[12px] items-start justify-center relative shrink-0">
      <div onClick={() => navigate('/di-san-step-1')} className="h-[60px] relative rounded-[30px] shrink-0 cursor-pointer hover:bg-white/15 hover:scale-105 active:scale-95 transition-all duration-300 ease-in-out" data-name="Button">
        <div className="content-stretch flex isolate items-center overflow-clip px-[30px] py-[16px] relative rounded-[inherit] size-full">
          <p className="[word-break:break-word] font-['Inter:Medium',sans-serif] font-medium leading-[22px] not-italic relative shrink-0 text-[20px] text-white whitespace-nowrap z-[1]">Cấu trúc</p>
        </div>
        <div aria-hidden="true" className="absolute border border-solid border-white inset-0 pointer-events-none rounded-[30px]" />
      </div>
      {isNextActive ? (
        <div onClick={() => navigate('/di-san-step-3')} className="h-[60px] w-[151px] relative rounded-[30px] shrink-0 cursor-pointer hover:scale-105 hover:brightness-110 active:scale-95 transition-all duration-300 ease-in-out animate-in fade-in" data-name="Button Active">
          <img src={imgButtonActive} alt="Tiếp theo" className="absolute inset-0 w-full h-full object-contain pointer-events-none" />
        </div>
      ) : (
