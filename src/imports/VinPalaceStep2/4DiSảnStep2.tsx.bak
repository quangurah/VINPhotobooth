function Upload({ preview, setPreview }: { preview: string | null, setPreview: (s: string | null) => void }) {

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        setPreview(event.target?.result as string);
      };
      reader.readAsDataURL(file);
    }
  };

  return (
    <label 
      className={`backdrop-blur-[12px] bg-[rgba(248,160,109,0.3)] content-stretch flex flex-col items-center p-[22px] relative rounded-[22px] shadow-[0px_12px_20px_0px_rgba(207,110,59,0.5)] shrink-0 w-full max-w-[466px] cursor-pointer hover:bg-[rgba(248,160,109,0.4)] hover:scale-[1.02] active:scale-[0.99] transition-all duration-300 overflow-hidden group ${
        preview ? 'h-auto gap-[22px]' : 'min-h-[211px] justify-center gap-[26px]'
      }`} 
      data-name="UPLOAD"
    >
      <input type="file" accept="image/*" className="hidden" onChange={handleFileChange} />
      {preview ? (
        <div className="w-full flex flex-col items-center gap-[20px]">
          <div className="w-full rounded-[12px] overflow-hidden">
            <img src={preview} alt="Preview" className="w-full h-auto block" />
          </div>
          <div className="bg-white rounded-full px-[20px] py-[8px] flex items-center gap-[8px] shadow-[0px_4px_10px_rgba(0,0,0,0.15)] hover:bg-gray-50 active:scale-95 transition-all duration-300 z-20 w-fit">
            <RotateCw className="size-[16px] text-[#091E42]" />
            <span className="text-[#091E42] font-['Inter:Semi_Bold',sans-serif] font-semibold text-[14px] whitespace-nowrap">Đổi hình</span>
          </div>
        </div>
      ) : (
        <div className="w-full flex flex-col items-center justify-center gap-[24px]">
          <AddImage />
          <Frame16 />
        </div>
      )}
    </label>
  );
}

