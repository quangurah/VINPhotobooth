    <OldMagazineCard bgImage={imgMaleQuanNuong} name="Anh LÃ¢n" description="Chá»§ chuá»—i quÃ¡n nÆ°á»›ng kÃ­n bÃ n má»—i tá»‘i" isCard4={true} />,
