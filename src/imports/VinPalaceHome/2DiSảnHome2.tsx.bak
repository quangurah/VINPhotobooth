          <Frame15 />
          <Frame59 isOpen={isOpen1} onToggle={() => setIsOpen1(!isOpen1)} />
          <Frame58 isOpen={isOpen2} onToggle={() => setIsOpen2(!isOpen2)} />
          <Frame68 isOpen={isOpen3} onToggle={() => setIsOpen3(!isOpen3)} />
          <Frame57 isChecked={isChecked} onToggle={() => setIsChecked(!isChecked)} />
          <div 
            className="content-stretch flex h-[60px] isolate items-center overflow-clip px-[30px] py-[16px] relative rounded-[30px] shrink-0 transition-all duration-300" 
            style={{ 
              backgroundImage: "linear-gradient(269.949deg, rgb(237, 28, 36) 0%, rgb(239, 64, 41) 19.152%, rgb(255, 103, 31) 99.992%)",
              opacity: isChecked ? 1 : 0.5,
              cursor: isChecked ? 'pointer' : 'not-allowed'
