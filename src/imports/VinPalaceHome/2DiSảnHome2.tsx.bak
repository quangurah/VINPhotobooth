            data-name="Button"
            onClick={() => {
              if (isChecked) {
                navigate("/di-san-step-1");
              }
            }}
          >
            <p className="[word-break:break-word] font-['Inter:Bold',sans-serif] font-bold leading-[22px] not-italic relative shrink-0 text-[24px] text-white whitespace-nowrap z-[1]">Tham gia ngay</p>
          </div>
        </div>
      </div>
    </div>
  );
}

