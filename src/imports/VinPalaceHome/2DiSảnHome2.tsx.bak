    <OldMagazineCard bgImage={imgFemaleThoMay} name="Chá»‹ Ly" description="NhÃ  thiáº¿t káº¿ Ã¡o dÃ i truyá»n thá»‘ng vÆ°Æ¡n táº§m tháº¿ giá»›i" isCard4={true} />,
    // Card 14 - ChÃº Long (Thá»£ may - Nam)
    <OldMagazineCard bgImage={imgMaleThoMay} name="ChÃº Long" description="Nghá»‡ nhÃ¢n may Ä‘o comple cao cáº¥p cho cÃ¡c doanh nhÃ¢n" isCard4={true} />,
    // Card 15 - CÃ´ Hiá»n (Äáº§u báº¿p - Ná»¯)
    <OldMagazineCard bgImage={imgFemaleDauBep} name="CÃ´ Hiá»n" description="Chá»§ quÃ¡n phá»Ÿ gia truyá»n 3 Ä‘á»i vá»›i cÃ´ lÃ  Ä‘á»i Ä‘áº§u tiÃªn" isCard4={true} />,
    // Card 16 - Anh HÆ°ng (Äáº§u báº¿p - Nam)
    <OldMagazineCard bgImage={imgMaleDauBep} name="Anh HÆ°ng" description="Äáº§u báº¿p Ä‘áº¡t sao Michelin mang áº©m thá»±c Viá»‡t ra tháº¿ giá»›i" isCard4={true} />
  ];

  useEffect(() => {
    let animId: number;

    const animate = (timestamp: number) => {
      lastTimeRef.current = timestamp;

      if (isDraggingRef.current) {
        // Äang kÃ©o thÃ¬ khÃ´ng tá»± cháº¡y
      } else if (Math.abs(velocityRef.current) > VELOCITY_THRESHOLD) {
        angleRef.current += velocityRef.current;
        velocityRef.current *= FRICTION;
      } else if (!isAutoRef.current) {
        const target = getSnapAngle(angleRef.current);
        const diff = target - angleRef.current;
        if (Math.abs(diff) > 0.01) {
          angleRef.current += diff * SNAP_STIFFNESS;
        } else {
          angleRef.current = target;
        }
      } else {
        angleRef.current += AUTO_SPEED;
      }

      // --- Render: tÃ­nh toÃ¡n phá»‘i cáº£nh 3D ---
      const container = containerRef.current;
      if (!container) {
        animId = requestAnimationFrame(animate);
        return;
      }

      const items = container.querySelectorAll<HTMLElement>('[data-carousel-item]');
      let activeIdx = 0;
      let minNorm = Infinity;

      const containerWidth = container.clientWidth || 1200;
      const isMobile = containerWidth < 768;
      const isTablet = containerWidth >= 768 && containerWidth < 1024;

      let dynamicRadiusX = containerWidth * 0.72;
      if (isMobile) {
        dynamicRadiusX = containerWidth * 0.35;
      } else if (isTablet) {
        dynamicRadiusX = containerWidth * 0.55;
      }
      dynamicRadiusX = Math.min(isMobile ? 180 : (isTablet ? 450 : 1300), Math.max(isMobile ? 110 : (isTablet ? 240 : 380), dynamicRadiusX));

      const currentMinScale = isMobile ? 0.50 : 0.72;
      const currentMaxScale = isMobile ? 0.85 : 1.15;

      items.forEach((item, i) => {
        const theta = ((i * ANGLE_STEP + angleRef.current) % 360 + 360) % 360;
        const rad = (theta * Math.PI) / 180;
        const cosVal = Math.cos(rad);
        const sinVal = Math.sin(rad);
        const perspectiveFactor = 1.6 / (1.6 + cosVal);
        const x = sinVal * dynamicRadiusX * perspectiveFactor;

        // norm: 0 (xa nháº¥t, á»Ÿ giá»¯a mÃ n hÃ¬nh) -> 1 (gáº§n nháº¥t)
        const norm = (1.0 - cosVal) / 2;

        // Scale: áº£nh xa nháº¥t nhá», áº£nh gáº§n to ra
        const scale = currentMinScale + (currentMaxScale - currentMinScale) * norm;

        // Hiá»‡u á»©ng cong chá»¯ U nháº¹
        const yOffset = norm * -10;

        let angleDiff = theta;
        if (angleDiff > 180) angleDiff -= 360;
        const rotateY = -angleDiff * 0.65;

        // zIndex: card gáº§n Ä‘Ã¨ card xa
        const zIndex = Math.round(norm * 1000);

        if (norm < minNorm) {
          minNorm = norm;
          activeIdx = i;
        }

        let opacity = 1.0;
        if (norm > 0.42) {
          opacity = Math.max(0, 1.0 - (norm - 0.42) / 0.15);
        }

        // Tá»± Ä‘á»™ng má» vÃ  áº©n card khi Ä‘i sÃ¡t rÃ¬a trÃ¡i/pháº£i mÃ n hÃ¬nh (vÃ¹ng sá»c cam)
        const absX = Math.abs(x);
        const limitVisibleX = isMobile ? containerWidth * 0.45 : (isTablet ? containerWidth * 0.46 : containerWidth * 0.48);
        const limitHiddenX = isMobile ? containerWidth * 0.55 : (isTablet ? containerWidth * 0.54 : containerWidth * 0.56);
        if (absX > limitVisibleX) {
          const fadeFactor = Math.max(0, 1.0 - (absX - limitVisibleX) / (limitHiddenX - limitVisibleX));
          opacity = opacity * fadeFactor;
        }

        // Ãp dá»¥ng CSS transform vÃ  zIndex
        item.style.transform = `translateX(${x}px) translateY(${yOffset}px) scale(${scale}) rotateY(${rotateY}deg)`;
        item.style.opacity = `${opacity}`;
        item.style.zIndex = `${zIndex}`;
        item.style.pointerEvents = norm < 0.65 ? 'auto' : 'none';
      });

      // --- Cáº­p nháº­t dot chá»‰ sá»‘ ---
      const dotsContainer = dotsRef.current;
      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll<HTMLElement>('[data-dot]');
        dots.forEach((dot, i) => {
          const isActive = i === activeIdx;
          dot.style.width = isActive ? '24px' : '8px';
          dot.style.background = isActive
            ? 'linear-gradient(90deg, #ed1c24, #ff671f)'
            : 'rgba(0,0,0,0.25)';
        });
      }

      animId = requestAnimationFrame(animate);
    };

    animId = requestAnimationFrame(animate);
    return () => cancelAnimationFrame(animId);
  }, []);

  // KÃ©o tháº£ báº±ng chuá»™t
  const handleDragStart = (clientX: number) => {
    isDraggingRef.current = true;
    isAutoRef.current = false;
    velocityRef.current = 0;
    dragStartXRef.current = clientX;
    dragStartAngle.current = angleRef.current;
    lastDragXRef.current = clientX;
    if (autoTimerRef.current) clearTimeout(autoTimerRef.current);
  };

  const handleDragMove = (clientX: number) => {
    if (!isDraggingRef.current) return;
    const deltaX = clientX - dragStartXRef.current;
    angleRef.current = dragStartAngle.current + deltaX * DRAG_SENSITIVITY;
    velocityRef.current = (clientX - lastDragXRef.current) * DRAG_SENSITIVITY;
    lastDragXRef.current = clientX;
  };

  const handleDragEnd = () => {
    isDraggingRef.current = false;
    autoTimerRef.current = window.setTimeout(() => {
      isAutoRef.current = true;
    }, AUTO_RESUME_DELAY);
  };

  const onMouseDown = (e: React.MouseEvent) => {
    e.preventDefault();
    handleDragStart(e.clientX);
  };
  const onMouseMove = (e: React.MouseEvent) => handleDragMove(e.clientX);
  const onMouseUp = () => handleDragEnd();
  const onMouseLeave = () => { if (isDraggingRef.current) handleDragEnd(); };

  // KÃ©o tháº£ báº±ng cáº£m á»©ng
  const onTouchStart = (e: React.TouchEvent) => handleDragStart(e.touches[0].clientX);
  const onTouchMove = (e: React.TouchEvent) => handleDragMove(e.touches[0].clientX);
  const onTouchEnd = () => handleDragEnd();

  const handleDotClick = (index: number) => {
    isAutoRef.current = false;
    velocityRef.current = 0;
    const targetAngle = -index * ANGLE_STEP;
    const currentNorm = ((angleRef.current % 360) + 360) % 360;
    const targetNorm = ((targetAngle % 360) + 360) % 360;
    let diff = targetNorm - currentNorm;
    if (diff > 180) diff -= 360;
    if (diff < -180) diff += 360;
    angleRef.current = angleRef.current + diff;
    if (autoTimerRef.current) clearTimeout(autoTimerRef.current);
    autoTimerRef.current = window.setTimeout(() => {
      isAutoRef.current = true;
    }, AUTO_RESUME_DELAY);
  };

  return (
    <div
      className="relative shrink-0 w-full select-none h-[380px] md:h-[500px]"
      style={{
        overflow: 'hidden',
        cursor: isDraggingRef.current ? 'grabbing' : 'grab',
        perspective: '1200px',
      }}
      onMouseDown={onMouseDown}
      onMouseMove={onMouseMove}
      onMouseUp={onMouseUp}
      onMouseLeave={onMouseLeave}
      onTouchStart={onTouchStart}
      onTouchMove={onTouchMove}
      onTouchEnd={onTouchEnd}
    >
      <div
        ref={containerRef}
        className="w-full relative flex justify-center items-center h-[320px] md:h-[440px]"
        style={{
          transformStyle: 'preserve-3d',
        }}
      >
        {cards.map((card, i) => (
          <div
            key={i}
            data-carousel-item
            className="absolute w-[190px] h-[270px] md:w-[240px] md:h-[340px] lg:w-[282.686px] lg:h-[400px]"
            style={{
              willChange: 'transform, opacity',
              boxShadow: 'none',
              borderRadius: '16px',
              transformStyle: 'preserve-3d',
              backfaceVisibility: 'hidden',
            }}
          >
            {card}
          </div>
        ))}
      </div>

      <div ref={dotsRef} className="absolute bottom-[12px] left-1/2 -translate-x-1/2 flex gap-[8px] z-[2000]">
        {Array.from({ length: totalCards }).map((_, i) => (
          <div
            key={i}
            data-dot
            onClick={() => handleDotClick(i)}
            style={{
              width: '8px',
              height: '8px',
              background: 'rgba(0,0,0,0.25)',
              borderRadius: '4px',
              transition: 'width 0.3s ease, background 0.3s ease',
              cursor: 'pointer',
            }}
          />
        ))}
      </div>
    </div>
  );
}

