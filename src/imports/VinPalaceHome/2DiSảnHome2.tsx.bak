function Frame36() {
  const totalCards = 16;
  const containerRef = useRef<HTMLDivElement>(null);
  const dotsRef = useRef<HTMLDivElement>(null);

  // === State refs (dÃ¹ng ref thay Ä‘á»ƒ trÃ¡nh re-render má»—i frame lÃ m giÃ¡n Ä‘oáº¡n chuyá»ƒn Ä‘á»™ng) ===
  const angleRef = useRef(0);          // GÃ³c xoay hiá»‡n táº¡i (degree)
  const velocityRef = useRef(0);       // Váº­n tá»‘c quÃ¡n tÃ­nh khi tháº£ drag
  const isDraggingRef = useRef(false);  // Äang kÃ©o?
  const dragStartXRef = useRef(0);     // Vá»‹ trÃ­ X lÃºc báº¯t Ä‘áº§u kÃ©o
  const dragStartAngle = useRef(0);    // GÃ³c lÃºc báº¯t Ä‘áº§u kÃ©o
  const lastDragXRef = useRef(0);      // Vá»‹ trÃ­ X frame trÆ°á»›c (tÃ­nh velocity)
  const lastTimeRef = useRef(0);       // Timestamp frame trÆ°á»›c
  const isAutoRef = useRef(true);      // Auto-rotate Ä‘ang báº­t?
  const autoTimerRef = useRef(0);      // Timer Ä‘áº¿m idle â†’ báº­t láº¡i auto

  // === Cáº¥u hÃ¬nh carousel ===
  const ANGLE_STEP = 360 / totalCards;  // GÃ³c giá»¯a 2 card liÃªn tiáº¿p
  const RADIUS_X = 280;                // BÃ¡n kÃ­nh tráº£i ngang (px) - Ä‘iá»u chá»‰nh Ä‘á»™ rá»™ng phá»‘i cáº£nh
  const MIN_SCALE = 0.72;              // Scale card xa nháº¥t (á»Ÿ giá»¯a mÃ n hÃ¬nh)
  const MAX_SCALE = 1.15;              // Scale card gáº§n nháº¥t (á»Ÿ hai bÃªn rÃ¬a mÃ n hÃ¬nh)
  const AUTO_SPEED = 0.15;             // Tá»‘c Ä‘á»™ tá»± xoay (deg/frame)
  const DRAG_SENSITIVITY = 0.35;       // Há»‡ sá»‘ nháº¡y khi kÃ©o
  const SNAP_STIFFNESS = 0.08;         // Äá»™ cá»©ng spring snap (0..1)
  const FRICTION = 0.92;               // Ma sÃ¡t quÃ¡n tÃ­nh (0..1)
  const VELOCITY_THRESHOLD = 0.05;     // NgÆ°á»¡ng dá»«ng quÃ¡n tÃ­nh
  const AUTO_RESUME_DELAY = 3000;      // Thá»i gian idle trÆ°á»›c khi báº­t láº¡i auto (ms)
  const CARD_W = 282.686;
  const CARD_H = 400;

  // === HÃ m tÃ­nh gÃ³c snap gáº§n nháº¥t ===
  const getSnapAngle = (angle: number): number => {
    const norm = ((angle % 360) + 360) % 360;
    const snapped = Math.round(norm / ANGLE_STEP) * ANGLE_STEP;
    return angle - norm + snapped;
  };

