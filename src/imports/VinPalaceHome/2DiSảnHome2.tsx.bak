    // Card 1 - Chá»‹ Hoa (BÃ¡nh má»³ - Ná»¯)
    <OldMagazineCard bgImage={imgFemaleBanhMy} name="Chá»‹ Hoa" description="Chá»§ xe bÃ¡nh má»³ káº¹p thá»‹t nÆ°á»›ng ná»©c tiáº¿ng phá»‘ cá»•" isCard4={true} />,
