function CardGoiY({
  title,
  iconSvg,
  isSelected,
  onClick
}: {
  title: string;
  iconSvg: React.ReactNode;
  isSelected: boolean;
  onClick: () => void;
}) {
  return (
    <div 
      onClick={onClick}
      className={`backdrop-blur-[12px] border border-[rgba(255,255,255,0.4)] content-stretch flex flex-col gap-[24px] items-center min-h-[264px] pb-[24px] pt-[40px] px-[20px] relative rounded-[20px] shadow-[0px_12px_20px_0px_rgba(207,110,59,0.5)] hover:shadow-xl shrink-0 w-[220px] cursor-pointer hover:scale-105 active:scale-98 transition-all duration-300 ${
        isSelected 
          ? 'bg-gradient-to-b from-[#F5401E] to-[#F6603B]' 
          : 'bg-[rgba(248,160,109,0.3)] hover:from-[#F5401E] hover:to-[#F6603B]'
      }`}
    >
      <div className="relative shrink-0 size-[80px]">
        {iconSvg}
      </div>
      <div className="content-stretch flex items-start justify-center relative shrink-0 w-full">
        <p className="[text-box-edge:cap_alphabetic] [text-box-trim:trim-both] [word-break:break-word] flex-[1_0_0] font-['Inter:Regular',sans-serif] font-normal leading-[28px] min-w-px not-italic relative text-[20px] text-center text-white">
          {title}
        </p>
      </div>
      <div className="absolute content-stretch flex items-center justify-center left-[10px] rounded-[10px] size-[24px] top-[10px]">
        <div className="relative rounded-[10px] shrink-0 size-[20px]">
          <div className={`absolute inset-0 border-2 border-solid border-white rounded-[10px] ${isSelected ? 'bg-white' : ''}`} />
          {isSelected && (
            <div className="absolute inset-[4px] bg-[#F5401E] rounded-[6px]" />
          )}
        </div>
      </div>
    </div>
  );
}

