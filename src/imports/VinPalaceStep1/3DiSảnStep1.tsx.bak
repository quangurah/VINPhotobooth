      <div className="content-stretch flex gap-[12px] items-center pl-[8px] pr-[20px] py-[8px] relative rounded-[26px] shrink-0 cursor-pointer hover:scale-105 active:scale-95 transition-all duration-300 pointer-events-auto" data-name="Button_Tiep noi di san">
        <img alt="" className="absolute inset-0 max-w-none object-cover pointer-events-none rounded-[26px] size-full" src={imgButtonTiepNoiDiSan1} />
        <div className="overflow-clip relative shrink-0 size-[24px]" data-name="Icon/info">
          <div className="absolute inset-[0_-0.05%_0_0]" data-name="Vector">
            <svg className="absolute block inset-0 size-full" fill="none" preserveAspectRatio="none" viewBox="0 0 24.0127 24">
              <path d={svgPaths.p64c6d60} fill="var(--fill-0, white)" />
            </svg>
          </div>
        </div>
        <p className="[word-break:break-word] font-['Inter:Medium',sans-serif] font-medium leading-[normal] not-italic relative shrink-0 text-[16px] text-center text-white whitespace-nowrap">{`Thể lệ & Giải thưởng`}</p>
      </div>
    </div>
  );
}

export default function Component3DiSnStep() {
  const [selectedIndex, setSelectedIndex] = useState<number | null>(null);
  const [inputText, setInputText] = useState<string>('');
  const navigate = useNavigate();

  const handlePrev = () => {
    navigate('/di-san-home-2');
  };

  const handleNext = () => {
    navigate('/di-san-step-2');
  };

  return (
    <div className="bg-[#FFCF84] relative w-full min-h-screen flex flex-col items-center" data-name="3. Di sản/Step 1">
      <div className="absolute bottom-0 h-[1173px] left-0 pointer-events-none top-0">
        <Bg />
      </div>
      <Frame12 
        selectedIndex={selectedIndex} 
        setSelectedIndex={setSelectedIndex} 
        inputText={inputText} 
        setInputText={setInputText}
        onPrev={handlePrev}
        onNext={handleNext}
      />
      <div className="absolute bg-white h-[40.035px] left-0 right-0 top-0" />
      <Frame27 onBack={handlePrev} />
      <div className="fixed top-0 left-0 right-0 pointer-events-none z-[9999]">
        <Header />
      </div>
    </div>
  );
}