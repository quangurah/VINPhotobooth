// e:\msb\tapchidisan\trang chủ\src\app\pages\Dashboard.tsx

import { useState, useEffect } from "react";
import { Link } from "react-router";
import { 
  LineChart, Line, BarChart, Bar, PieChart, Pie, Cell, 
  XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer 
} from "recharts";
import { 
  Users, CheckCircle, AlertTriangle, Clock, Search, Filter, 
  Download, Eye, Terminal, RefreshCw, X, ChevronLeft, ChevronRight, Share2 
} from "lucide-react";

// Định nghĩa base URL trỏ thẳng tới API
const isLocal = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
const BASE_URL = isLocal ? "http://127.0.0.1:5001/vinpalace-df621/asia-southeast1/api" : "/api";


const STYLE_NAMES: Record<string, string> = {
  default: "Mặc định",
  business: "Kinh doanh",
  luxury: "Sang trọng",
  shop: "Cửa hàng",
  saving: "Tiết kiệm"
};

const STYLE_COLORS = ["#ff671f", "#ef4029", "#ffb81c", "#10b981", "#3b82f6"];

interface LogEntry {
  timestamp: string;
  type: "log" | "info" | "warn" | "error";
  message: string;
}

interface Session {
  id: string;
  name: string;
  description: string;
  rawImageUrl: string;
  cropImageUrl: string;
  removebgImageUrl: string;
  finalImageUrl: string;
  qrCodeUrl: string;
  styleId: string;
  logs: LogEntry[];
  renderDuration?: number;
  createdAt: string;
  downloadCount?: number;
  shareCount?: number;
}

interface OverviewData {
  total_jobs: number;
  success_jobs: number;
  failed_jobs: number;
  success_rate: number;
  error_rate: number;
  avg_render_time: number;
  style_counts: Record<string, number>;
  trend_labels: string[];
  trend_values: number[];
  hourly_activity: number[];
  top_users: { name: string; count: number }[];
  total_downloads?: number;
  total_shares?: number;
}

export default function Dashboard() {
  // States cho Overview
  const [overview, setOverview] = useState<OverviewData | null>(null);
  const [loadingOverview, setLoadingOverview] = useState(true);
  
  // States cho Sessions Table
  const [sessions, setSessions] = useState<Session[]>([]);
  const [meta, setMeta] = useState({ currentPage: 1, totalPages: 1, totalItems: 0 });
  const [loadingSessions, setLoadingSessions] = useState(true);

  // Filters & Search
  const [page, setPage] = useState(1);
  const [search, setSearch] = useState("");
  const [styleId, setStyleId] = useState("");

  // Modals
  const [activePhotoModal, setActivePhotoModal] = useState<{ url: string; title: string } | null>(null);
  const [activeLogModal, setActiveLogModal] = useState<{ logs: LogEntry[]; name: string } | null>(null);

  // Fetch Overview Data
  const fetchOverview = async () => {
    setLoadingOverview(true);
    try {
      const res = await fetch(`${BASE_URL}/tclife/dashboard-overview`);
      const data = await res.json();
      if (data.ok) {
        setOverview(data);
      }
    } catch (e) {
      console.error("Lỗi fetch overview:", e);
    } finally {
      setLoadingOverview(false);
    }
  };

  // Fetch Sessions Data
  const fetchSessions = async () => {
    setLoadingSessions(true);
    try {
      const queryParams = new URLSearchParams({
        page: String(page),
        limit: "10",
        search,
        styleId
      });
      const res = await fetch(`${BASE_URL}/tclife/dashboard-sessions?${queryParams.toString()}`);
      const data = await res.json();
      if (data.ok) {
        setSessions(data.data);
        setMeta({
          currentPage: data.meta.current_page,
          totalPages: data.meta.total_pages,
          totalItems: data.meta.total_items
        });
      }
    } catch (e) {
      console.error("Lỗi fetch sessions:", e);
    } finally {
      setLoadingSessions(false);
    }
  };

  useEffect(() => {
    fetchOverview();
  }, []);

  useEffect(() => {
    fetchSessions();
  }, [page, styleId]);

  const handleSearchSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setPage(1);
    fetchSessions();
  };

  // Xuất file CSV
  const handleExportCSV = () => {
    if (sessions.length === 0) return;
    
    // Header cột
    const headers = ["Mã phiên", "Tên người chơi", "Chủ đề", "Mô tả di sản", "Ảnh gốc", "Ảnh kết quả", "Thời gian AI (giây)", "Lượt tải", "Lượt share", "Thời gian tham gia"];
    
    // Rows dữ liệu
    const rows = sessions.map(s => [
      s.id,
      s.name,
      STYLE_NAMES[s.styleId] || s.styleId,
      s.description.replace(/"/g, '""'), // Escape dấu nháy kép
      s.rawImageUrl || "",
      s.finalImageUrl || "",
      s.renderDuration || "0",
      s.downloadCount || "0",
      s.shareCount || "0",
      s.createdAt ? new Date(s.createdAt).toLocaleString("vi-VN") : ""
    ]);

    // Tạo CSV content kèm theo UTF-8 BOM để Excel hiển thị đúng tiếng Việt
    const csvContent = 
      "\uFEFF" + 
      [headers.join(","), ...rows.map(e => e.map(val => `"${val}"`).join(","))].join("\n");

    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.setAttribute("href", url);
    link.setAttribute("download", `Bao_cao_MSB_Di_San_${Date.now()}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  // Chuẩn bị dữ liệu cho biểu đồ Recharts
  const getTrendData = () => {
    if (!overview) return [];
    return overview.trend_labels.map((label, idx) => ({
      name: label,
      "Lượt tham gia": overview.trend_values[idx]
    }));
  };

  const getHourlyData = () => {
    if (!overview) return [];
    return overview.hourly_activity.map((val, idx) => ({
      name: `${idx}h`,
      "Số lượt": val
    }));
  };

  const getStylePieData = () => {
    if (!overview) return [];
    return Object.entries(overview.style_counts).map(([key, val]) => ({
      name: STYLE_NAMES[key] || key,
      value: val
    }));
  };

  return (
    <div className="min-h-screen bg-[#0b0c10] text-[#f7f8f9] font-sans antialiased pb-12">
      {/* Background Gradient */}
      <div className="absolute inset-0 bg-radial-at-t from-[#ff671f]/15 via-[#0b0c10]/0 to-[#0b0c10] pointer-events-none z-0 min-h-screen" />
      
      <div className="relative z-10 max-w-[1440px] mx-auto px-4 lg:px-8 pt-6 flex flex-col gap-6">
        
        {/* Header */}
        <header className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-800 pb-5">
          <div className="flex flex-col gap-1">
            <div className="flex items-center gap-3">
              <span className="h-8 w-1.5 rounded-full bg-[#ff671f]" />
              <h1 className="text-2xl lg:text-3xl font-extrabold tracking-tight bg-gradient-to-r from-white via-gray-200 to-[#ff671f] bg-clip-text text-transparent">
                MSB TẠP CHÍ DI SẢN
              </h1>
            </div>
            <p className="text-sm text-gray-400 font-medium pl-4">
              Hệ thống quản trị & phân tích dữ liệu chiến dịch tạp chí
            </p>
          </div>
          
          <div className="flex items-center gap-3 w-full md:w-auto">
            <button 
              onClick={() => { fetchOverview(); fetchSessions(); }} 
              className="flex items-center gap-2 px-4 py-2 text-sm bg-gray-800 hover:bg-gray-700 active:scale-95 text-white font-semibold rounded-xl border border-gray-750 transition-all cursor-pointer"
            >
              <RefreshCw className="h-4 w-4" />
              Làm mới
            </button>
            <Link 
              to="/di-san-home-2" 
              className="flex items-center gap-2 px-5 py-2 text-sm bg-gradient-to-r from-[#ff671f] to-[#ef4029] hover:brightness-110 active:scale-95 text-white font-bold rounded-xl shadow-lg shadow-[#ff671f]/20 transition-all cursor-pointer"
            >
              Vào Game
            </Link>
          </div>
        </header>

        {/* Stats Grid */}
        <section className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          <div className="bg-gray-900/60 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-3 shadow-md">
            <div className="flex justify-between items-center text-gray-400">
              <span className="text-xs font-bold uppercase tracking-wider">Tổng số lượt chơi</span>
              <div className="p-2 rounded-lg bg-[#ff671f]/10 text-[#ff671f]">
                <Users className="h-5 w-5" />
              </div>
            </div>
            {loadingOverview ? (
              <div className="h-9 w-20 bg-gray-800 animate-pulse rounded-md" />
            ) : (
              <p className="text-3xl font-black text-white">{overview?.total_jobs || 0}</p>
            )}
            <p className="text-[11px] text-gray-500 font-medium">Lượt khởi tạo session trên Firestore</p>
          </div>

          <div className="bg-gray-900/60 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-3 shadow-md">
            <div className="flex justify-between items-center text-gray-400">
              <span className="text-xs font-bold uppercase tracking-wider">Lượt tạo ảnh thành công</span>
              <div className="p-2 rounded-lg bg-emerald-500/10 text-emerald-400">
                <CheckCircle className="h-5 w-5" />
              </div>
            </div>
            {loadingOverview ? (
              <div className="h-9 w-20 bg-gray-800 animate-pulse rounded-md" />
            ) : (
              <p className="text-3xl font-black text-emerald-400">{overview?.success_jobs || 0}</p>
            )}
            <p className="text-[11px] text-gray-500 font-medium">Đã sinh ảnh tạp chí & composite</p>
          </div>

          <div className="bg-gray-900/60 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-3 shadow-md">
            <div className="flex justify-between items-center text-gray-400">
              <span className="text-xs font-bold uppercase tracking-wider">Tỷ lệ thành công</span>
              <div className="p-2 rounded-lg bg-blue-500/10 text-blue-400">
                <Clock className="h-5 w-5" />
              </div>
            </div>
            {loadingOverview ? (
              <div className="h-9 w-20 bg-gray-800 animate-pulse rounded-md" />
            ) : (
              <p className="text-3xl font-black text-blue-400">{overview?.success_rate || 0}%</p>
            )}
            <p className="text-[11px] text-gray-500 font-medium">Đo bằng lượt hoàn thành save-session</p>
          </div>

          <div className="bg-gray-900/60 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-3 shadow-md">
            <div className="flex justify-between items-center text-gray-400">
              <span className="text-xs font-bold uppercase tracking-wider">Thời gian AI trung bình</span>
              <div className="p-2 rounded-lg bg-amber-500/10 text-amber-400">
                <AlertTriangle className="h-5 w-5" />
              </div>
            </div>
            {loadingOverview ? (
              <div className="h-9 w-20 bg-gray-800 animate-pulse rounded-md" />
            ) : (
              <p className="text-3xl font-black text-amber-400">{overview?.avg_render_time || 0}s</p>
            )}
            <p className="text-[11px] text-gray-500 font-medium">Imagen Gen + Remove BG và ghép ảnh</p>
          </div>

          <div className="bg-gray-900/60 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-3 shadow-md">
            <div className="flex justify-between items-center text-gray-400">
              <span className="text-xs font-bold uppercase tracking-wider">Lượt tải ảnh về</span>
              <div className="p-2 rounded-lg bg-cyan-500/10 text-cyan-400">
                <Download className="h-5 w-5" />
              </div>
            </div>
            {loadingOverview ? (
              <div className="h-9 w-20 bg-gray-800 animate-pulse rounded-md" />
            ) : (
              <p className="text-3xl font-black text-cyan-400">{overview?.total_downloads || 0}</p>
            )}
            <p className="text-[11px] text-gray-500 font-medium">Lượt click tải từ trang kết quả</p>
          </div>

          <div className="bg-gray-900/60 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-3 shadow-md">
            <div className="flex justify-between items-center text-gray-400">
              <span className="text-xs font-bold uppercase tracking-wider">Lượt chia sẻ hệ thống</span>
              <div className="p-2 rounded-lg bg-purple-500/10 text-purple-400">
                <Share2 className="h-5 w-5" />
              </div>
            </div>
            {loadingOverview ? (
              <div className="h-9 w-20 bg-gray-800 animate-pulse rounded-md" />
            ) : (
              <p className="text-3xl font-black text-purple-400">{overview?.total_shares || 0}</p>
            )}
            <p className="text-[11px] text-gray-500 font-medium">Lượt click chia sẻ từ trang kết quả</p>
          </div>
        </section>

        {/* Charts Section */}
        <section className="grid grid-cols-1 lg:grid-cols-3 gap-5">
          {/* Daily Trend Chart */}
          <div className="lg:col-span-2 bg-gray-900/40 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-4">
            <h3 className="text-sm font-bold uppercase tracking-wider text-gray-400">Xu hướng tham gia (14 ngày qua)</h3>
            <div className="h-[250px] w-full">
              {loadingOverview ? (
                <div className="h-full w-full bg-gray-800/40 animate-pulse rounded-xl" />
              ) : (
                <ResponsiveContainer width="100%" height="100%">
                  <LineChart data={getTrendData()}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#2a2e35" />
                    <XAxis dataKey="name" stroke="#9ca3af" fontSize={11} />
                    <YAxis stroke="#9ca3af" fontSize={11} allowDecimals={false} />
                    <Tooltip contentStyle={{ backgroundColor: "#1f2937", border: "1px solid #374151", color: "#f3f4f6" }} />
                    <Line type="monotone" dataKey="Lượt tham gia" stroke="#ff671f" strokeWidth={3} activeDot={{ r: 6 }} />
                  </LineChart>
                </ResponsiveContainer>
              )}
            </div>
          </div>

          {/* Style Distribution Chart */}
          <div className="bg-gray-900/40 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-4">
            <h3 className="text-sm font-bold uppercase tracking-wider text-gray-400">Phân bố Chủ đề Tạp chí</h3>
            <div className="h-[200px] w-full flex items-center justify-center">
              {loadingOverview ? (
                <div className="h-32 w-32 bg-gray-800/40 animate-pulse rounded-full" />
              ) : (
                <ResponsiveContainer width="100%" height="100%">
                  <PieChart>
                    <Pie
                      data={getStylePieData()}
                      cx="50%"
                      cy="50%"
                      innerRadius={60}
                      outerRadius={80}
                      paddingAngle={4}
                      dataKey="value"
                    >
                      {getStylePieData().map((entry, index) => (
                        <Cell key={`cell-${index}`} fill={STYLE_COLORS[index % STYLE_COLORS.length]} />
                      ))}
                    </Pie>
                    <Tooltip contentStyle={{ backgroundColor: "#1f2937", border: "1px solid #374151", color: "#f3f4f6" }} />
                  </PieChart>
                </ResponsiveContainer>
              )}
            </div>
            {/* Legend */}
            <div className="grid grid-cols-2 gap-2 text-xs">
              {getStylePieData().map((entry, index) => (
                <div key={entry.name} className="flex items-center gap-2">
                  <span className="h-2.5 w-2.5 rounded-full" style={{ backgroundColor: STYLE_COLORS[index % STYLE_COLORS.length] }} />
                  <span className="text-gray-400 font-medium truncate">{entry.name}: {entry.value}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section className="grid grid-cols-1 gap-5">
          {/* Hourly Activity */}
          <div className="bg-gray-900/40 backdrop-blur-md border border-gray-800 rounded-2xl p-5 flex flex-col gap-4">
            <h3 className="text-sm font-bold uppercase tracking-wider text-gray-400">Hoạt động trong ngày theo giờ</h3>
            <div className="h-[250px] w-full">
              {loadingOverview ? (
                <div className="h-full w-full bg-gray-800/40 animate-pulse rounded-xl" />
              ) : (
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={getHourlyData()}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#2a2e35" />
                    <XAxis dataKey="name" stroke="#9ca3af" fontSize={10} />
                    <YAxis stroke="#9ca3af" fontSize={11} allowDecimals={false} />
                    <Tooltip contentStyle={{ backgroundColor: "#1f2937", border: "1px solid #374151", color: "#f3f4f6" }} />
                    <Bar dataKey="Số lượt" fill="#ef4029" radius={[4, 4, 0, 0]} />
                  </BarChart>
                </ResponsiveContainer>
              )}
            </div>
          </div>
        </section>

        {/* Filters and Search Container */}
        <section className="bg-gray-900/50 backdrop-blur-md border border-gray-800 rounded-2xl p-4 flex flex-col md:flex-row justify-between items-center gap-4">
          <form onSubmit={handleSearchSubmit} className="flex items-center bg-gray-950 border border-gray-800 rounded-xl px-3 py-1.5 w-full md:w-80">
            <Search className="h-4 w-4 text-gray-500 mr-2" />
            <input 
              type="text" 
              placeholder="Tìm tên, mô tả, ID..." 
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              className="bg-transparent border-none outline-none text-sm w-full text-white placeholder-gray-500 focus:ring-0"
            />
            <button type="submit" className="hidden" />
          </form>

          <div className="flex flex-wrap items-center gap-3 w-full md:w-auto">
            <div className="flex items-center gap-2 bg-gray-950 border border-gray-800 px-3 py-1.5 rounded-xl text-sm">
              <Filter className="h-3.5 w-3.5 text-gray-400" />
              <select 
                value={styleId} 
                onChange={(e) => { setStyleId(e.target.value); setPage(1); }}
                className="bg-transparent border-none text-white outline-none cursor-pointer pr-4"
              >
                <option value="">Tất cả chủ đề</option>
                {Object.entries(STYLE_NAMES).map(([key, name]) => (
                  <option key={key} value={key} className="bg-gray-900">{name}</option>
                ))}
              </select>
            </div>

            <button 
              onClick={handleExportCSV} 
              className="flex items-center gap-2 px-4 py-2 bg-[#ff671f]/10 text-[#ff671f] hover:bg-[#ff671f]/20 font-bold rounded-xl text-xs uppercase tracking-wider transition-all cursor-pointer"
            >
              <Download className="h-4 w-4" />
              Xuất Excel
            </button>
          </div>
        </section>

        {/* Sessions Table */}
        <section className="bg-gray-900/30 border border-gray-800 rounded-2xl overflow-hidden shadow-xl">
          <div className="overflow-x-auto">
            <table className="w-full text-left border-collapse">
              <thead>
                <tr className="border-b border-gray-800 bg-gray-900/60 text-xs font-bold uppercase tracking-wider text-gray-400">
                  <th className="py-4 px-5">Tên người chơi</th>
                  <th className="py-4 px-5">Chủ đề</th>
                  <th className="py-4 px-5 max-w-[250px] truncate">Mô tả di sản</th>
                  <th className="py-4 px-5">Media</th>
                  <th className="py-4 px-5">Thời gian AI</th>
                  <th className="py-4 px-5">Tải về</th>
                  <th className="py-4 px-5">Chia sẻ</th>
                  <th className="py-4 px-5">Thời gian</th>
                  <th className="py-4 px-5 text-right">Hành động</th>
                </tr>
              </thead>
              <tbody>
                {loadingSessions ? (
                  Array(5).fill(0).map((_, i) => (
                    <tr key={i} className="border-b border-gray-800/50 bg-gray-900/10">
                      <td className="py-4 px-5"><div className="h-4 w-28 bg-gray-800 animate-pulse rounded-md" /></td>
                      <td className="py-4 px-5"><div className="h-4 w-20 bg-gray-800 animate-pulse rounded-md" /></td>
                      <td className="py-4 px-5"><div className="h-4 w-44 bg-gray-800 animate-pulse rounded-md" /></td>
                      <td className="py-4 px-5"><div className="h-6 w-16 bg-gray-800 animate-pulse rounded-full" /></td>
                      <td className="py-4 px-5"><div className="h-4 w-12 bg-gray-800 animate-pulse rounded-md" /></td>
                      <td className="py-4 px-5"><div className="h-4 w-8 bg-gray-800 animate-pulse rounded-md" /></td>
                      <td className="py-4 px-5"><div className="h-4 w-8 bg-gray-800 animate-pulse rounded-md" /></td>
                      <td className="py-4 px-5"><div className="h-4 w-24 bg-gray-800 animate-pulse rounded-md" /></td>
                      <td className="py-4 px-5"><div className="h-8 w-24 bg-gray-800 animate-pulse rounded-md ml-auto" /></td>
                    </tr>
                  ))
                ) : sessions.length === 0 ? (
                  <tr>
                    <td colSpan={9} className="py-12 text-center text-gray-500 font-medium text-sm">
                      Không tìm thấy dữ liệu phiên chơi nào.
                    </td>
                  </tr>
                ) : (
                  sessions.map((s) => (
                    <tr key={s.id} className="border-b border-gray-800/40 hover:bg-gray-900/20 transition-colors text-sm">
                      <td className="py-4 px-5 font-semibold text-white">
                        <div className="flex flex-col gap-0.5">
                          <span>{s.name}</span>
                          <span className="text-[10px] text-gray-500 font-mono select-all">{s.id}</span>
                        </div>
                      </td>
                      <td className="py-4 px-5">
                        <span className="px-2 py-0.5 bg-gray-850 border border-gray-850 rounded-lg text-xs font-semibold text-gray-300">
                          {STYLE_NAMES[s.styleId] || s.styleId}
                        </span>
                      </td>
                      <td className="py-4 px-5 max-w-[250px] truncate text-gray-300" title={s.description}>
                        {s.description}
                      </td>
                      <td className="py-4 px-5">
                        <div className="flex items-center gap-2">
                          {s.rawImageUrl && (
                            <button 
                              onClick={() => setActivePhotoModal({ url: s.rawImageUrl, title: `Ảnh gốc - ${s.name}` })}
                              className="px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs text-gray-300 font-semibold cursor-pointer"
                            >
                              Ảnh gốc
                            </button>
                          )}
                          {s.finalImageUrl && (
                            <button 
                              onClick={() => setActivePhotoModal({ url: s.finalImageUrl, title: `Ảnh kết quả - ${s.name}` })}
                              className="px-2 py-1 bg-[#ff671f]/10 hover:bg-[#ff671f]/20 rounded text-xs text-[#ff671f] font-semibold cursor-pointer"
                            >
                              Tạp chí
                            </button>
                          )}
                        </div>
                      </td>
                      <td className="py-4 px-5 text-sm font-semibold text-amber-555">
                        {s.renderDuration ? `${s.renderDuration}s` : "N/A"}
                      </td>
                      <td className="py-4 px-5 text-sm font-semibold text-cyan-400">
                        {s.downloadCount || 0}
                      </td>
                      <td className="py-4 px-5 text-sm font-semibold text-purple-400">
                        {s.shareCount || 0}
                      </td>
                      <td className="py-4 px-5 text-xs text-gray-400">
                        {s.createdAt ? new Date(s.createdAt).toLocaleString("vi-VN") : "N/A"}
                      </td>
                      <td className="py-4 px-5 text-right">
                        <button 
                          onClick={() => setActiveLogModal({ logs: s.logs || [], name: s.name })}
                          className="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-950 hover:bg-gray-800 rounded-lg border border-gray-800 text-xs font-bold text-gray-400 hover:text-white transition-all cursor-pointer"
                        >
                          <Terminal className="h-3.5 w-3.5" />
                          Xem Log ({s.logs?.length || 0})
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>

          {/* Pagination */}
          {!loadingSessions && meta.totalPages > 1 && (
            <div className="flex justify-between items-center px-6 py-4 bg-gray-900/30 border-t border-gray-800/80">
              <span className="text-xs text-gray-500 font-semibold">
                Hiển thị trang {meta.currentPage}/{meta.totalPages} ({meta.totalItems} kết quả)
              </span>
              <div className="flex items-center gap-2">
                <button 
                  disabled={page === 1}
                  onClick={() => setPage(prev => Math.max(prev - 1, 1))}
                  className="p-1.5 rounded-lg border border-gray-800 bg-gray-950 text-gray-400 hover:text-white disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer"
                >
                  <ChevronLeft className="h-4 w-4" />
                </button>
                <button 
                  disabled={page === meta.totalPages}
                  onClick={() => setPage(prev => Math.min(prev + 1, meta.totalPages))}
                  className="p-1.5 rounded-lg border border-gray-800 bg-gray-950 text-gray-400 hover:text-white disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer"
                >
                  <ChevronRight className="h-4 w-4" />
                </button>
              </div>
            </div>
          )}
        </section>

      </div>

      {/* Modal Xem ảnh */}
      {activePhotoModal && (
        <div className="fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200">
          <div className="bg-gray-900 border border-gray-850 rounded-2xl overflow-hidden max-w-[500px] w-full shadow-2xl relative">
            <div className="flex justify-between items-center px-5 py-4 border-b border-gray-800 bg-gray-950/50">
              <h4 className="text-sm font-bold text-white uppercase">{activePhotoModal.title}</h4>
              <button 
                onClick={() => setActivePhotoModal(null)}
                className="text-gray-500 hover:text-white p-1 hover:bg-gray-800 rounded-lg transition-colors cursor-pointer"
              >
                <X className="h-5 w-5" />
              </button>
            </div>
            <div className="p-5 flex justify-center items-center bg-gray-950/20 max-h-[70vh] overflow-y-auto">
              <img 
                src={activePhotoModal.url} 
                alt="Preview" 
                className="max-w-full max-h-[60vh] object-contain rounded-lg border border-gray-800 shadow-md"
              />
            </div>
            <div className="px-5 py-3 border-t border-gray-800 bg-gray-950/50 text-right">
              <a 
                href={activePhotoModal.url} 
                target="_blank" 
                rel="noreferrer" 
                className="inline-flex items-center gap-1.5 px-4 py-2 bg-[#ff671f] hover:brightness-110 text-white text-xs font-bold rounded-lg transition-all"
              >
                <Eye className="h-3.5 w-3.5" />
                Mở trong tab mới
              </a>
            </div>
          </div>
        </div>
      )}

      {/* Modal Xem Log Terminal */}
      {activeLogModal && (
        <div className="fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-black/85 backdrop-blur-sm animate-in fade-in duration-200">
          <div className="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden max-w-[800px] w-full shadow-2xl relative">
            <div className="flex justify-between items-center px-5 py-4 border-b border-gray-850 bg-gray-950/70">
              <div className="flex items-center gap-2.5">
                <Terminal className="h-5 w-5 text-[#ff671f]" />
                <h4 className="text-sm font-bold text-white uppercase">Console Log của {activeLogModal.name}</h4>
              </div>
              <button 
                onClick={() => setActiveLogModal(null)}
                className="text-gray-500 hover:text-white p-1 hover:bg-gray-800 rounded-lg transition-colors cursor-pointer"
              >
                <X className="h-5 w-5" />
              </button>
            </div>
            <div className="p-5 bg-[#07080a] h-[60vh] overflow-y-auto font-mono text-xs flex flex-col gap-1.5 select-text">
              {activeLogModal.logs.length === 0 ? (
                <p className="text-gray-600 italic py-6 text-center">Không ghi nhận được log nào từ phiên chơi này.</p>
              ) : (
                activeLogModal.logs.map((log, index) => {
                  let colorClass = "text-gray-300";
                  if (log.type === "warn") colorClass = "text-amber-400";
                  if (log.type === "error") colorClass = "text-rose-500 font-semibold";
                  if (log.type === "info") colorClass = "text-blue-400";
                  
                  return (
                    <div key={index} className="flex items-start gap-3 border-b border-gray-950 pb-1">
                      <span className="text-gray-600 shrink-0 text-[10px]">
                        {new Date(log.timestamp).toLocaleTimeString("vi-VN", { hour12: false })}
                      </span>
                      <span className={`px-1 rounded bg-gray-900 font-bold tracking-wide uppercase shrink-0 text-[9px] ${
                        log.type === "error" ? "bg-rose-950/40 text-rose-400" : 
                        log.type === "warn" ? "bg-amber-950/40 text-amber-400" :
                        "text-gray-500"
                      }`}>
                        {log.type}
                      </span>
                      <p className={`whitespace-pre-wrap break-all flex-1 ${colorClass}`}>
                        {log.message}
                      </p>
                    </div>
                  );
                })
              )}
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
